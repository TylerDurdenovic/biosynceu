COMPANY_NAME="BioSyncLabs"
SITE_NAME="BioSyncLabs"
SHOPIFY_REVALIDATION_SECRET=""
SHOPIFY_STOREFRONT_ACCESS_TOKEN=""
SHOPIFY_STORE_DOMAIN="biosynclabs.myshopify.com"
SHOPIFY_ADMIN_CLIENT_ID=""
SHOPIFY_ADMIN_CLIENT_SECRET=""
NEXT_PUBLIC_SITE_URL=https://biosynclabs.de
# Bank-transfer details shown on the order-confirmed page (NEXT_PUBLIC_ so the
# customer-facing page can render them). Leave blank to hide.
NEXT_PUBLIC_BANK_HOLDER=""
NEXT_PUBLIC_BANK_IBAN=""
NEXT_PUBLIC_BANK_BIC=""
NEXT_PUBLIC_BANK_NAME=""

# Shopify "Order creation" webhook -> Telegram notification.
# SHOPIFY_WEBHOOK_SECRET: Shopify Admin → Settings → Notifications → Webhooks
#   (the "signature" secret shown at the bottom of the Webhooks section).
# TELEGRAM_BOT_TOKEN: from @BotFather.
# TELEGRAM_CHAT_ID: your group/channel chat id (negative for groups).
# SHOPIFY_STORE_DOMAIN (above) is reused for the admin order link.
SHOPIFY_WEBHOOK_SECRET=""
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# /admin orders dashboard login. Set these in Vercel (Production scope) —
# do NOT put real values in this file, it is committed to git.
# ADMIN_SESSION_SECRET: any long random string, e.g. `openssl rand -hex 32`.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_SESSION_SECRET=""
